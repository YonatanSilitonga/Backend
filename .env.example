# ===== App =====
PORT=8080
JWT_SECRET=change-me-in-production

# ===== Database (Supabase) =====
# Isi dari dashboard Supabase: Settings -> Database -> Connection string -> URI
# Gunakan port 5432 (session pooler) untuk Go/pgx
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
