# ===== App =====
PORT=8080
JWT_SECRET=change-me-in-production

# ===== Database (Supabase) =====
# Isi dari dashboard Supabase: Settings -> Database -> Connection string -> URI
# Gunakan port 5432 (session pooler) untuk Go/pgx
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ===== Tracking / Status Online =====
# Ambang offline (menit tanpa GPS terbaru). Default 15.
TRACKING_OFFLINE_MIN=15
# Ambang session online (jam sejak login tanpa aktivitas). Default 12.
SESSION_OFFLINE_HOURS=12
# WAJIB session login aktif buat status LIVE (anti data ghost).
# NYALAIN (true) HANYA setelah app mobile sudah pakai alur login /auth/login.
# Default false = status online tetap dari GPS aja (perilaku lama).
SESSION_REQUIRED=false
